//Container of the Raymarch (Flickering/Fix rotation/Add jump/Add Trail/Add Secondary spheres/) 
struct RaymarchStruct
{
    float3 ActorPosition;
    float3 SphereCenters[10];
    float SphereRadii[10];
    int SphereCount;
    Texture2D Tex;
    SamplerState TexSampler;
    
    //====================================================
    // Signed Distance Functions (SDF)
    //====================================================
    float sdBox(float3 center, float3 halfSize, float roundness)
    {
        float3 q = abs(center) - halfSize;
        return length(max(q, 0.0)) - roundness;
    }

    float sdSphere(float3 p, float3 center, float r)
    {
        return length(p - center) - r;
    }

    float smin(float a, float b, float k)
    {
        float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
        return lerp(b, a, h) - k * h * (1.0 - h);
    }

    //====================================================
    // Map con array di sfere
    //====================================================

    float map(float3 p,float3 BoxCenter,float3 BoxSize,float BoxRoundness,float Smoothness)
    {
        float d = sdBox(p-BoxCenter, BoxSize*0.5, BoxRoundness);
    
        for (int i = 0; i < SphereCount; i++) {
            float di = sdSphere(p, SphereCenters[i], SphereRadii[i]);
            d = smin(d, di, Smoothness);
        }

        return d;
    }
    
    //====================================================
    // Normal
    //====================================================

    float3 getNormal(float3 p, float3 BoxCenter, float3 BoxSize, float BoxRoundness, float Smoothness)
    {
        float eps = 0.0005;
        float3 dx = float3(eps, 0.0, 0.0);
        float3 dy = float3(0.0, eps, 0.0);
        float3 dz = float3(0.0, 0.0, eps);

        float nx = map(p + dx, BoxCenter, BoxSize, BoxRoundness, Smoothness) - map(p - dx, BoxCenter, BoxSize, BoxRoundness, Smoothness);
        float ny = map(p + dy, BoxCenter, BoxSize, BoxRoundness, Smoothness) - map(p - dy, BoxCenter, BoxSize, BoxRoundness, Smoothness);
        float nz = map(p + dz, BoxCenter, BoxSize, BoxRoundness, Smoothness) - map(p - dz, BoxCenter, BoxSize, BoxRoundness, Smoothness);

        return normalize(float3(nx, ny, nz));
    }

    //====================================================
    // Triplanar Texture will apply the given texture to the object no matter the shape of it (da fixare) 
    //====================================================

    float3 SampleTriplanar(Texture2D Tex, SamplerState Sampler, float3 p, float3 normal, float scale)
    {
        
        float3 blend = abs(normal);
        blend = pow(blend, 4.0);
        blend /= (blend.x + blend.y + blend.z);

        float2 uvX = p.yz * scale;
        float2 uvY = p.zx * scale;
        float2 uvZ = p.xy * scale;

        uvX = frac(uvX);
        uvY = frac(uvY);
        uvZ = frac(uvZ);

        float3 colX = Tex.Sample(Sampler, uvX).rgb;
        float3 colY = Tex.Sample(Sampler, uvY).rgb;
        float3 colZ = Tex.Sample(Sampler, uvZ).rgb;

        return colX * blend.x + colY * blend.y + colZ * blend.z;
    }

    //====================================================
    // Compile Function 
    //====================================================

    float4 RaymarchExecute(float3 CameraPos,float3 WorldPos,float3 BoxCenter,float3 BoxSize,float BoxRoundness,float Smoothness,int MaxSteps,float MaxDistance,float HitThreshold,float TexScale)
    {
        float3 ro = CameraPos;
        float3 rd = normalize(WorldPos - CameraPos);
        float t = 0.0;
        float3 p;
        bool hit = false;
        float3 localPos;
        [loop]
        for (int i = 0; i < MaxSteps; i++) 
        {
            p = ro + rd * t;
            localPos=p-ActorPosition;
            float dist = map(localPos,BoxCenter,BoxSize,BoxRoundness,Smoothness);

            if (dist < HitThreshold) {
                hit = true;
                break;
            }
            if (t > MaxDistance) break;

            t += dist;
        }

        if (hit)
        {
            float3 normal = getNormal(localPos, BoxCenter, BoxSize, BoxRoundness, Smoothness);
            float3 texColor = SampleTriplanar(Tex,TexSampler, localPos, normal, TexScale);
            return float4(texColor, 1.0);
        }

        return float4(0, 0, 0, 0);
    }
};



